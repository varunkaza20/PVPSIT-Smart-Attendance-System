# Copy to backend/.env and fill in. NEVER commit the real .env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/pvpsit-attendance
# Required: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=12h
# Comma-separated browser origins allowed to call the API (required in production), e.g.
# CORS_ORIGINS=http://192.168.1.10:5173,http://localhost:5173
CORS_ORIGINS=
# Optional: passwords used by `npm run seed` / resetUsers.js (min 8 chars). If empty, random ones are generated and printed once.
SEED_ADMIN_PASSWORD=
SEED_FACULTY_PASSWORD=

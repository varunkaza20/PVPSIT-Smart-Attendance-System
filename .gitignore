# =====================================================================
# PVPSIT Smart Attendance System - .gitignore
# Covers: backend (Node/Express/TS), frontend (React/Vite/TS), OS/IDE
# =====================================================================

# ---------------------------------------------------------------------
# SECRETS & ENVIRONMENT (never commit these)
# backend/.env holds MONGO_URI, JWT_SECRET, JWT_EXPIRY, PORT, NODE_ENV
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json

# ---------------------------------------------------------------------
# STUDENT DATA (personal data: real names + roll numbers)
# Imported into MongoDB via the seed script / Admin import wizard.
# Keep these local or in private storage, not in a public repo.
# ---------------------------------------------------------------------
II_Year_Students_Data.xlsx
III_Year_Students_Data.xlsx
IV_Year_Students_Data.xlsx
*_Students_Data.xlsx
*_Students_Data.xls
*_Students_Data.csv

# Generated reports / exports and uploaded files
exports/
uploads/
backend/uploads/
Day_Report_*.xlsx
Weekly_Report_*.xlsx
Monthly_Report_*.xlsx
Subject_Report_*.xlsx
Student_Report_*.xlsx
Defaulters_*.xlsx
Defaulters_*.pdf

# Database dumps / local MongoDB data
*.bson
dump/
mongodb-data/
data/db/

# ---------------------------------------------------------------------
# DEPENDENCIES
# ---------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/
.npm/
.eslintcache

# ---------------------------------------------------------------------
# BUILD OUTPUT (regenerated by `npm run build`)
# backend -> tsc -> backend/dist, frontend -> vite build -> frontend/dist
# ---------------------------------------------------------------------
dist/
**/dist/
build/
out/
*.tsbuildinfo
.vite/
.cache/
.parcel-cache/

# ---------------------------------------------------------------------
# LOGS
# ---------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------
# TESTING / COVERAGE
# ---------------------------------------------------------------------
coverage/
.nyc_output/

# ---------------------------------------------------------------------
# EDITOR / IDE
# ---------------------------------------------------------------------
.vscode/
.idea/
.cursor/
.antigravity/
.gemini/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------
# OS FILES
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# TEMP / MISC
# ---------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
~$*
.tmp/
tmp/

# Local DB backups (contain password hashes)
backups/
backend/backups/

# ---------------------------------------------------------------------
# Internal project specification docs (kept local, not published)
# ---------------------------------------------------------------------
/1_Project_Overview.md
/2_Database_Schema.md
/3_Auth_and_Backend.md
/4_UIUX.md
/5_Core_Logic.md
/6_Exports.md
/7_Final_Instructions.md
/Smart_Lab_Attendance_System.md

# Salesforce tooling folders (not part of this project)
.sf/
.sfdx/
